# Copy to .env.local for local development. In production, set the same
# variables in the Vercel project settings (or with `vercel env add`).
# See "Configuration" in README.md for what each one does.

# --- Required -----------------------------------------------------------

# Encrypts the session cookie. Generate with: openssl rand -base64 64
AUTH_SECRET=

# Cognito user pool issuer of the upstream Dante deployment.
DANTE_COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<pool-id>

# Cognito hosted-UI domain (sign-in screen).
DANTE_COGNITO_DOMAIN=https://auth.example.com

# Cognito app client for the agent: `terraform output -raw agent_client_id`
# in Dante's terraform/envs/prod.
DANTE_COGNITO_AGENT_CLIENT_ID=

# Base URL of the Dante API (without /api/agent).
DANTE_API_BASE_URL=https://dante.example.com

# Vercel AI Gateway key (not needed on Vercel when OIDC is available).
AI_GATEWAY_API_KEY=

# --- Uploads ------------------------------------------------------------

# Vercel Blob token for PDF uploads (added automatically when a Blob store
# is connected to the Vercel project).
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/cleanup-uploads. Vercel sends it as a bearer token.
CRON_SECRET=

# Days to keep uploaded PDFs before the daily cleanup deletes them.
# UPLOAD_RETENTION_DAYS=

# --- Developer scripts (optional) ----------------------------------------

# Deployed Minos URL that `npm run tui` proxies to.
# MINOS_TUI_TARGET=https://your-minos.vercel.app
# MINOS_TUI_CALLBACK_PORT=8765
# MINOS_TUI_PROXY_PORT=8766

# Local callback port for scripts/get-test-token.ts.
# GET_TOKEN_PORT=8765
